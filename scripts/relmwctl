#!/bin/sh
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 elidot
# relmwctl - operator CLI for the relmw supervisor control surface.
#
#   relmwctl [-m DIR] status | events [N] | fault <none|bump|percep_bias|slippery|random|nominal>
#            | plan <push_A[,push_B...]> | arm <mw|naive|none> | knock | pause | resume | reset-stats | quit | watch [SECONDS]
#
# DIR defaults to $RELMW_MOUNT, else /dev/relmw if it exists, else /tmp/relmw.
# POSIX sh only: runs under QNX ksh as well as Linux dash/bash.
#
# Exit codes: 0 = reply started with "OK" (or read command succeeded), 1 = command rejected / reply not OK,
#             2 = usage error.

set -u

usage() {
  echo "usage: relmwctl [-m DIR] status | events [N] | fault <none|bump|percep_bias|slippery|random|nominal>" >&2
  echo "                 | plan <push_A[,push_B...]> | arm <mw|naive|none> | knock | pause | resume | reset-stats | quit | watch [SECONDS]" >&2
}

DIR=${RELMW_MOUNT:-}
if [ -z "$DIR" ]; then
  if [ -d /dev/relmw ]; then DIR=/dev/relmw; else DIR=/tmp/relmw; fi
fi

while [ $# -gt 0 ]; do
  case $1 in
    -m)
      if [ $# -lt 2 ]; then echo "relmwctl: -m needs a directory argument" >&2; usage; exit 2; fi
      DIR=$2; shift 2;;
    --) shift; break;;
    -*) echo "relmwctl: unknown option $1" >&2; usage; exit 2;;
    *)  break;;
  esac
done

cmd=${1:-}
arg=${2:-}

# QNX API simulation on Linux (not QNX): with RELMW_QNX_SIM=1, a mount served by the simulated resource manager
# (compat/qnx_sim) is a socket under $QNXSIM_ROOT; reads/writes go through qnxsim_io (= cat / echo on QNX).
SIM_IO=
if [ "${RELMW_QNX_SIM:-0}" = 1 ]; then
  sim_root=${QNXSIM_ROOT:-/tmp/qnxsim-$(id -u)}
  if [ -S "$sim_root$DIR/status" ]; then
    SIM_IO=${QNXSIM_IO:-$(command -v qnxsim_io 2>/dev/null)}
    [ -n "$SIM_IO" ] || { echo "relmwctl: RELMW_QNX_SIM=1 but qnxsim_io not found (set QNXSIM_IO)" >&2; exit 1; }
  fi
fi
rd() { if [ -n "$SIM_IO" ]; then "$SIM_IO" read "$1"; else cat "$1"; fi; }
wr() { if [ -n "$SIM_IO" ]; then "$SIM_IO" write "$1" "$2"; else printf '%s\n' "$2" > "$1"; fi; }

# Send "<line>" to DIR/ctl and print the reply. POSIX host (FIFO ctl): the reply lands in DIR/reply;
# wait up to ~2 s for it to change (content or mtime) before printing. QNX resmgr: the reply to the
# last command is read back with cat DIR/ctl.
send_cmd() {
  line=$1
  if [ -z "$SIM_IO" ] && [ -p "$DIR/ctl" ]; then
    reply=$DIR/reply
    old=$(cat "$reply" 2>/dev/null)
    marker=$(mktemp 2>/dev/null) || marker=
    [ -n "$marker" ] && : > "$marker"
    if ! printf '%s\n' "$line" > "$DIR/ctl"; then
      echo "relmwctl: cannot write $DIR/ctl" >&2
      [ -n "$marker" ] && rm -f "$marker"
      exit 1
    fi
    new=$old
    i=0
    while [ $i -lt 20 ]; do
      new=$(cat "$reply" 2>/dev/null)
      [ "$new" != "$old" ] && break
      [ -n "$marker" ] && [ "$reply" -nt "$marker" ] && break
      sleep 0.1 2>/dev/null || sleep 1
      i=$((i + 1))
    done
    [ -n "$marker" ] && rm -f "$marker"
    printf '%s\n' "$new"
    case $new in
      OK*) return 0;;
      *)   return 1;;
    esac
  else
    if ! wr "$DIR/ctl" "$line"; then
      echo "relmwctl: cannot write $DIR/ctl" >&2
      exit 1
    fi
    out=$(rd "$DIR/ctl" 2>/dev/null)
    printf '%s\n' "$out"
    case $out in
      OK*) return 0;;
      *)   return 1;;
    esac
  fi
}

case $cmd in
  status)
    rd "$DIR/status"
    exit $?;;
  events)
    if [ $# -gt 2 ]; then usage; exit 2; fi
    n=${arg:-20}
    case $n in
      ''|*[!0-9]*) echo "relmwctl: events: N must be a number" >&2; usage; exit 2;;
    esac
    rd "$DIR/events" | tail -n "$n"
    exit $?;;
  watch)
    secs=${arg:-1}
    case $secs in
      ''|*[!0-9]*) echo "relmwctl: watch: SECONDS must be a number" >&2; usage; exit 2;;
    esac
    while :; do
      rd "$DIR/status"
      sleep "$secs"
    done;;
  fault|plan|arm|shield|policy)
    [ -n "$arg" ] || { usage; exit 2; }
    send_cmd "$cmd $arg"; exit $?;;
  knock|pause|resume|reset-stats|quit)
    send_cmd "$cmd"; exit $?;;
  '')
    usage; exit 2;;
  *)
    echo "relmwctl: unknown command $cmd" >&2; usage; exit 2;;
esac
